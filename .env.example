# ---------------------------------------------------------------------------
# Sala de Profes — sucursal 24 y Maipú
# Copiar a .env.local (local) y cargar las mismas en Vercel → Settings →
# Environment Variables. NINGUNA se reutiliza de LVE: todas son de esta sucursal.
# ---------------------------------------------------------------------------

# --- Supabase (Project Settings → API) --------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Solo para scripts/run-migration.mjs en tu compu (no hace falta en Vercel)
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# --- Fudo de esta sucursal ---------------------------------------------------
# Usar login/password o apiKey/apiSecret. Sin esto la app no toca Fudo.
FUDO_LOGIN=
FUDO_PASSWORD=
FUDO_API_KEY=
FUDO_API_SECRET=
# Opcional: ids de medios de pago de ESTE Fudo por si /payment-methods no responde.
# Sacarlos de GET /payment-methods una vez conectado. Ej: {"efectivo":"1","transferencia":"5"}
FUDO_MEDIOS_PAGO=

# --- Crons (Vercel y pg_cron) ------------------------------------------------
# Generar uno nuevo: openssl rand -hex 32
CRON_SECRET=

# --- URL pública de la app (mails, briefing, relojes) ------------------------
# OBLIGATORIA en la VPS (no hay VERCEL_*). Es NEXT_PUBLIC_: cambiarla requiere recompilar.
NEXT_PUBLIC_APP_URL=

# --- Ubicación del local para fichar -----------------------------------------
# Sin lat/lng el fichaje queda bloqueado. Sacarlas de Google Maps (clic derecho
# sobre la puerta del local → copiar coordenadas).
NEXT_PUBLIC_VENUE_LAT=
NEXT_PUBLIC_VENUE_LNG=
NEXT_PUBLIC_VENUE_RADIUS_M=75
NEXT_PUBLIC_VENUE_NAME=La Vieja Escuela — 24 y Maipú

# --- Notificaciones push -----------------------------------------------------
# Generar un par nuevo: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Emails (Resend) ---------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=Sala de Profes <info@laviejaescuelabar.com.ar>

# --- Telegram (resúmenes de turno y semanal) — bot PROPIO de la 24 -------------
# Un bot distinto al de LVE: 'vincular' lee la cola de mensajes del bot.
TELEGRAM_JOB_BOT=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=

# --- IA ----------------------------------------------------------------------
OPENROUTER_MODEL=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
